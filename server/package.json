{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=./src --watch-path=../content --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "ingest": "node --import tsx src/ingest.ts",
    "eval:rag": "node --import tsx src/eval-rag.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.16.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
