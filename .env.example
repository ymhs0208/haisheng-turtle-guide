# 伺服器連接埠。開發時手機與展示箱會把 /api 與 /ws 轉過來。
PORT=43125

# 留空就用 JSON 檔備援（server/data/runtime.json）。
# 用 docker compose 時會自動指到 PostgreSQL + pgvector。
DATABASE_URL=

# mock：不需要金鑰，答覆來自館內樣本。openai：走 OpenAI 相容 API。
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 1 允許示範介面指定實驗組與剩餘時間。正式收集資料時設成 0。
ALLOW_GROUP_OVERRIDE=1

# 留空則工作人員頁與 CSV 在示範環境開放。
ADMIN_TOKEN=

# 團體題各階段毫秒數，一般不用改。
# SHOW_ANNOUNCE_MS=8000
# SHOW_ANSWER_MS=20000
# SHOW_RESULTS_MS=8000
# SHOW_EXPLAIN_MS=18000
