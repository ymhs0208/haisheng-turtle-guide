# 伺服器連接埠。開發時手機與展示箱會把 /api 與 /ws 轉過來。
PORT=43125

# 留空就用 JSON 檔備援（server/data/runtime.json），檢索改在記憶體做餘弦。
# 用 docker compose 時會自動指到 PostgreSQL + pgvector。
DATABASE_URL=

# 相容 OpenAI 的聊天與嵌入。沒有金鑰時自動改走 mock，不必改程式。
# 設成 mock 會強制不用金鑰，就算下面有填。
LLM_PROVIDER=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# 本地 mock 向量固定 64 維，對得上資料庫的 vector(64)。
# 改接遠端嵌入時，把 EMBED_DIM 設成那個模型的維度。不是 64 就改在應用層算餘弦。
EMBED_DIM=64

# 其他供應者只要換網址、金鑰和模型名稱，例如：
# Gemini  OpenAI 相容：LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq：LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Ollama：LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1
#
# 沿用舊名也可以：OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_MODEL、EMBEDDING_MODEL。
# EMBEDDING_PROVIDER=local 會強制用本地向量，即使有聊天金鑰。

# 1 允許示範介面指定實驗組與剩餘時間。正式收集資料時設成 0。
ALLOW_GROUP_OVERRIDE=1

# 留空則工作人員頁與 CSV 在示範環境開放。
ADMIN_TOKEN=

# 團體題各階段毫秒數，一般不用改。
# SHOW_ANNOUNCE_MS=8000
# SHOW_ANSWER_MS=20000
# SHOW_RESULTS_MS=8000
# SHOW_EXPLAIN_MS=18000
